# ── AG Associates — Production Environment Template ──────────────────
# This file is copied to /srv/ag/.env by bootstrap-vps.sh.
# Replace every REPLACE_WITH_* value before first boot.
#
# Generate secrets:  openssl rand -hex 32
# Hash n8n password:  docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'

# ── Domain ───────────────────────────────────────────────────────────
DOMAIN=advaiityagade.com
ACME_EMAIL=admin@advaiityagade.com

# ── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_USER=agadmin
POSTGRES_PASSWORD=REPLACE_WITH_secure_password
POSTGRES_DB=agdb

# ── Redis ────────────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_secure_redis_password

# ── LLM / AI ─────────────────────────────────────────────────────────
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=llama-3.3-70b-versatile
LLM_API_KEY=REPLACE_WITH_groq_api_key
LLM_MOCK_MODE=false

# ── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=REPLACE_WITH_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_supabase_service_role_key
SUPABASE_ANON_KEY=REPLACE_WITH_supabase_anon_key
SUPABASE_JWT_SECRET=REPLACE_WITH_supabase_jwt_secret

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# ── n8n ──────────────────────────────────────────────────────────────
N8N_WEBHOOK_KEY=REPLACE_WITH_openssl_rand_hex_32
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD_HASH=REPLACE_WITH_caddy_hash_password

# ── Telegram Bot ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=REPLACE_WITH_bot_token_from_botfather

# ── Email Intake ─────────────────────────────────────────────────────
EMAIL_IMAP_HOST=REPLACE_WITH_imap_host
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=REPLACE_WITH_imap_user
EMAIL_IMAP_PASS=REPLACE_WITH_imap_password
EMAIL_POLL_INTERVAL=60

# ── Google Gemini (optional) ─────────────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Resend (optional) ────────────────────────────────────────────────
RESEND_API_KEY=

# ── NeSL e-Filing ────────────────────────────────────────────────────
NESL_API_KEY=
NESL_API_BASE_URL=https://api.nesl.co.in/v1
NESL_CLIENT_ID=
NESL_CLIENT_SECRET=
NESL_MOCK_DELAY_SEC=3

# ── IGR Portal ───────────────────────────────────────────────────────
IGR_PORTAL_URL=https://igrmaharashtra.gov.in/efiling/
IGR_PORTAL_USERNAME=
IGR_PORTAL_PASSWORD=

# ── GRAS Portal ──────────────────────────────────────────────────────
GRAS_PORTAL_URL=https://gras.mahakosh.gov.in/echallan/

# ── Runtime ──────────────────────────────────────────────────────────
ENVIRONMENT=production
IMAGE_TAG=latest
