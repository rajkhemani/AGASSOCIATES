{
  "name": "telegram-bot",
  "description": "AG Associates Telegram Bot for multi-agent orchestration",
  "type": "docker",
  "dockerCompose": {
    "version": "3.8",
    "services": {
      "telegram-bot": {
        "build": {
          "context": "./ag-associates-ai/backend/telegram_bot",
          "dockerfile": "Dockerfile"
        },
        "image": "ghcr.io/luxoranova9/telegram-bot:latest",
        "container_name": "ag_telegram_bot",
        "restart": "unless-stopped",
        "environment": {
          "TELEGRAM_BOT_TOKEN": "${TELEGRAM_BOT_TOKEN}",
          "REDIS_URL": "redis://:${REDIS_PASSWORD}@redis:6379",
          "TELEGRAM_BOT_PORT": "3003",
          "TELEGRAM_WEBHOOK_URL": "${TELEGRAM_WEBHOOK_URL}",
          "AISHA_API_URL": "http://ag-ai-backend:8000/api/aisha/chat",
          "N8N_WEBHOOK_KEY": "${N8N_WEBHOOK_KEY}",
          "LLM_API_KEY": "${LLM_API_KEY}",
          "LLM_BASE_URL": "https://api.groq.com/openai/v1"
        },
        "depends_on": [
          "redis",
          "ai-backend"
        ],
        "healthcheck": {
          "test": ["CMD", "curl", "-f", "http://localhost:3004/health"],
          "interval": "30s",
          "timeout": "5s",
          "start_period": "10s",
          "retries": 3
        },
        "networks": ["ag_net"],
        "labels": {
          "coolify.managed": "true",
          "coolify.service": "telegram-bot"
        }
      }
    },
    "networks": {
      "ag_net": {
        "driver": "bridge"
      }
    }
  },
  "domains": [],
  "environmentVariables": [
    { "key": "TELEGRAM_BOT_TOKEN", "value": "${TELEGRAM_BOT_TOKEN}", "isSecret": true },
    { "key": "REDIS_PASSWORD", "value": "${REDIS_PASSWORD}", "isSecret": true },
    { "key": "TELEGRAM_WEBHOOK_URL", "value": "${TELEGRAM_WEBHOOK_URL}", "isSecret": false },
    { "key": "AISHA_API_URL", "value": "http://ai-backend:8000/api/aisha/chat", "isSecret": false },
    { "key": "N8N_WEBHOOK_KEY", "value": "${N8N_WEBHOOK_KEY}", "isSecret": true },
    { "key": "LLM_API_KEY", "value": "${LLM_API_KEY}", "isSecret": true },
    { "key": "LLM_BASE_URL", "value": "https://api.groq.com/openai/v1", "isSecret": false },
    { "key": "TELEGRAM_BOT_TOKEN", "value": "${TELEGRAM_BOT_TOKEN}", "isSecret": true }
  ],
  "resourceLimits": {
    "cpu": "0.5",
    "memory": "512m",
    "memorySwap": "512m"
  },
  "buildSettings": {
    "buildPack": "dockerfile",
    "dockerfilePath": "./ag-associates-ai/backend/telegram_bot/Dockerfile",
    "contextPath": "./ag-associates-ai/backend/telegram_bot"
  },
  "port": 3003,
  "healthCheckPath": "/health",
  "healthCheckInterval": 30,
  "healthCheckTimeout": 5,
  "healthCheckRetries": 3,
  "healthCheckStartPeriod": 10
}