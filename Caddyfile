{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static private_ranges
	}
}

# AG Platform — LegalTech case management (Vite SPA + Express)
app.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy ag-platform:3001
	header / {
		Cache-Control "no-cache"
	}
	header /assets/* {
		Cache-Control "max-age=31536000, immutable"
	}
}

# AI Dashboard — migrated to app subdomain /admin/dashboard
dashboard.{$DOMAIN} {
	encode zstd gzip
	redir https://app.{$DOMAIN}/admin/dashboard{uri} permanent
}

# AI Backend API — FastAPI agents
api.{$DOMAIN} {
	encode zstd gzip
	handle_path /landing* {
		root * /srv/landing
		file_server
	}
	reverse_proxy /webhook* telegram-bot:3003
	reverse_proxy /api/sms/ingest* intake-api:3002
	reverse_proxy ai-backend:8000
}

# Intake API — SMS webhook, OTP bridge, bank intake
intake.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy intake-api:3002
}

# n8n orchestration UI — protected by Caddy basicauth on top of n8n's own auth
n8n.{$DOMAIN} {
	encode zstd gzip
	basic_auth {
		{$N8N_BASIC_AUTH_USER} {$N8N_BASIC_AUTH_PASSWORD_HASH}
	}
	reverse_proxy n8n:5678
}

# Landing page — premium hub served at root domain
{$DOMAIN} {
	encode zstd gzip
	root * /srv/landing
	try_files {path} {path}/ /index.html
	file_server
	header /index.html {
		Cache-Control "no-cache"
	}
	header /assets/* {
		Cache-Control "max-age=31536000, immutable"
	}
	header /* {
		Cache-Control "public, max-age=3600"
	}
}

# www redirect → root
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Clerk-style docs site — pure static, served by Caddy directly from a mounted dir
docs.{$DOMAIN} {
	encode zstd gzip
	root * /srv/docs
	redir / /quickstart 301
	try_files {path} {path}/ {path}.html /index.html
	file_server
	header /_public/* {
		Cache-Control "public, max-age=31536000, immutable"
	}
}
